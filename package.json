{
  "name": "the-way-i-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Related ideas about working with AI, in Markdown and optimized static HTML.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "node scripts/build.ts --check",
    "build:site": "node scripts/build.ts --site",
    "test": "node --test scripts/*.test.ts",
    "test:browser": "npm run build:site && playwright test",
    "dev": "node scripts/dev.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@pierre/diffs": "1.6.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@xmldom/xmldom": "0.9.12",
    "entities": "9.0.0",
    "jpeg-js": "0.4.4",
    "marked": "18.1.1",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
