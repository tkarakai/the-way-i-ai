{
  "name": "the-way-i-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Related ideas about working with AI, in Markdown and standalone HTML.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "node scripts/build.ts --check",
    "build:site": "node scripts/build.ts --site",
    "test": "node --test scripts/*.test.ts",
    "preview": "npm run build:site && node scripts/preview.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@pierre/diffs": "1.2.10",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "marked": "18.0.14",
    "typescript": "5.9.3"
  }
}
