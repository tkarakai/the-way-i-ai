{
  "name": "the-way-i-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Related ideas about working with AI, in Markdown and standalone HTML.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "node scripts/build.ts --check",
    "build:site": "node scripts/build.ts --site",
    "test": "node --test scripts/*.test.ts",
    "test:browser": "npm run build:site && npm run build:previews && playwright test",
    "build:previews": "node previews/build-backgrounds.ts",
    "preview:backgrounds": "npm run build && npm run build:previews",
    "preview": "npm run build:site && node scripts/preview.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@pierre/diffs": "1.2.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "jpeg-js": "0.4.4",
    "marked": "18.0.14",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
